{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bidupdat",
  "main": "src/index.js",
  "compatibility_date": "2026-07-14",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "keep_vars": true,
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "jatobid_analytics"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASE_BUCKET",
      "bucket_name": "jatoaibid"
    }
  ],
  "triggers": {
    "crons": [
      "0 17 * * *",
      "30 17 * * *",
      "0 18 * * *",
      "30 18 * * *",
      "0 19 * * *"
    ]
  }
}
